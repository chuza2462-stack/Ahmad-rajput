<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Interactive JavaScript Website</title>
    <style>
        /* --- CSS STYLING --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            color: #333;
            line-height: 1.6;
        }

        /* Navigation Bar */
        nav {
            background-color: #2c3e50;
            color: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav .logo {
            font-size: 1.5rem;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style: none;
        }

        nav ul li {
            margin-left: 20px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #1abc9c;
        }

        /* Hero Section */
        header {
            background: linear-gradient(135deg, #2c3e50, #1abc9c);
            color: white;
            height: 60vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
        }

        header h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.2rem;
            margin-bottom: 20px;
        }

        .btn {
            background-color: #e67e22;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: #d35400;
        }

        /* Main Content Container */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Interactive Feature Section */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            text-align: center;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        }

        /* Contact Section */
        .contact-form {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            max-width: 600px;
            margin: 40px auto;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        /* Footer */
        footer {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <!-- NAV BAR -->
    <nav>
        <div class="logo">JS Custom Site</div>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- HERO SECTION -->
    <header>
        <h1 id="welcome-heading">Welcome to Your New Website</h1>
        <p>Built with customized styles and interactive JavaScript features.</p>
        <button class="btn" id="magic-btn">Click for Magic!</button>
    </header>

    <div class="container">
        <!-- INTERACTIVE CARD SECTION -->
        <section id="services" style="margin-top: 40px;">
            <h2 style="text-align: center; margin-bottom: 20px;">Our Interactive Features</h2>
            <div class="features">
                <div class="card" onclick="alertCard('Feature One')">
                    <h3>💡 Creative Design</h3>
                    <p>Click me to trigger a unique custom alert response.</p>
                </div>
                <div class="card" onclick="alertCard('Feature Two')">
                    <h3>⚡ Fast Performance</h3>
                    <p>Optimized directly for modern web browsers.</p>
                </div>
                <div class="card" onclick="alertCard('Feature Three')">
                    <h3>📱 Fully Responsive</h3>
                    <p>Looks perfect on phones, tablets, and desktops.</p>
                </div>
            </div>
        </section>

        <!-- CONTACT FORM SECTION -->
        <section id="contact">
            <div class="contact-form">
                <h2 style="margin-bottom: 20px; text-align: center;">Get in Touch</h2>
                <form id="webForm">
                    <div class="form-group">
                        <label for="name">Name:</label>
                        <input type="text" id="name" required placeholder="Enter your name">
                    </div>
                    <div class="form-group">
                        <label for="email">Email:</label>
                        <input type="email" id="email" required placeholder="Enter your email">
                    </div>
                    <div class="form-group">
                        <label for="message">Message:</label>
                        <textarea id="message" rows="4" required placeholder="Your message here..."></textarea>
                    </div>
                    <button type="submit" class="btn" style="width: 100%;">Send Message</button>
                </form>
                <div id="form-feedback" style="margin-top: 15px; text-align: center; font-weight: bold; color: green;"></div>
            </div>
        </section>
    </div>

    <footer>
        <p>&copy; 2026 My JavaScript Website. All rights reserved.</p>
    </footer>

    <!-- --- JAVASCRIPT CODE --- -->
    <script>
        // 1. Changing header background colors dynamically using the Hero button
        const magicBtn = document.getElementById('magic-btn');
        const header = document.querySelector('header');
        const colors = [
            'linear-gradient(135deg, #2c3e50, #1abc9c)',
            'linear-gradient(135deg, #8e44ad, #3498db)',
            'linear-gradient(135deg, #11998e, #38ef7d)',
            'linear-gradient(135deg, #ff9966, #ff5e62)'
        ];
        let colorIndex = 0;

        magicBtn.addEventListener('click', () => {
            colorIndex = (colorIndex + 1) % colors.length;
            header.style.background = colors[colorIndex];
        });

        // 2. Interactive Feature Click Alerts
        function alertCard(featureName) {
            alert(`You clicked on ${featureName}! JavaScript successfully caught this click interaction.`);
        }

        // 3. Contact Form Submission handling (prevents page reload and shows feedback)
        const contactForm = document.getElementById('webForm');
        const formFeedback = document.getElementById('form-feedback');

        contactForm.addEventListener('submit', (event) => {
            event.preventDefault(); // Stop the form from reloading the page
            
            const nameInput = document.getElementById('name').value;
            
            // Display success message using JavaScript
            formFeedback.textContent = `Thank you, ${nameInput}! Your message was successfully sent (simulated).`;
            
            // Clear the form fields
            contactForm.reset();
            
            // Remove feedback text after 5 seconds
            setTimeout(() => {
                formFeedback.textContent = '';
            }, 5000);
        });
    </script>
</body>
</html>
